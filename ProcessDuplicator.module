<?php

namespace ProcessWire;

require_once(__DIR__ . DIRECTORY_SEPARATOR . 'Classes/DupUtil.php');
require_once(__DIR__ . DIRECTORY_SEPARATOR . 'Classes/DupCrypto.php');
require_once(__DIR__ . DIRECTORY_SEPARATOR . 'Classes/DupAdminApi.php');

/**
 * Setup > Duplicator: the admin app (packages and settings)
 *
 * The page is a single-page app built from ui/ (Vite + React) into Assets/app/.
 * It talks to DupAdminApi through setup/duplicator/api/. Downloads stay plain links.
 */
class ProcessDuplicator extends Process
{
  /** @var Duplicator */
  protected $dupmod = null;

  public static function getModuleInfo()
  {
    $package = json_decode(file_get_contents(__DIR__ . "/package.json"));

    return array(
      'title'     => 'Duplicator - Packages Manager',
      'summary'     => 'Build, list, download and restore Duplicator packages, and change its settings.',
      'version'     => $package->version,
      'author'     => 'flydev',
      'icon'       => 'clone',
      'href'       => 'https://processwire.com/talk/topic/15345-duplicator-backup-and-move-sites/',
      'permission'  => 'duplicator',
      'permissions' => array(
        'duplicator' => 'Run the Duplicator module'
      ),
      'page'       => array(
        'name' => 'duplicator',
        'parent' => 'setup',
        'title' => 'Duplicator'
      ),
      'require'     => 'Duplicator',
      'autoload'    => function () {
        return (wire('page')->process == 'ProcessDuplicator');
      }
    );
  }

  public function init()
  {
    parent::init();

    if ($this->permissions->get('duplicator')->id && !$this->user->hasPermission('duplicator')) {
      throw new WirePermissionException(__('Duplicator: You have no permission to use this module.'));
    }

    $this->dupmod = $this->modules->get(Duplicator::DUP_APPLICATION_NAME);
  }

  /**
   * The admin app, or a download (package, installer, encryption tool)
   */
  public function ___execute()
  {
    $input = $this->wire('input');
    $action = $this->wire('sanitizer')->text($input->get('action'));

    if ($action === 'dupcrypt') {
      // the encryption tool in one file, to generate keys and decrypt packages on another computer
      $script = DupCrypto::standaloneScript();
      header('Content-Type: application/octet-stream');
      header('Content-Disposition: attachment; filename="dupcrypt.php"');
      header('Content-Length: ' . strlen($script));
      echo $script;
      exit;
    }

    if ($action === 'packages' && $input->get('installer') !== null) {
      wireSendFile(__DIR__ . DS . 'Deploy' . DS . 'installer.php', array('forceDownload' => true, 'downloadFilename' => 'installer.php'));
    }

    if ($action === 'packages' && $input->get('file') !== null) {
      $filename = $this->wire('sanitizer')->filename($input->get('file'));
      $packages = DUP_Util::getPackages($this->dupmod->path, Duplicator::DUP_PACKAGE_EXTENSION);
      if (is_array($packages) && in_array($filename, $packages, true)) {
        wireSendFile($this->dupmod->path . DS . $filename, array('forceDownload' => true));
      }
      $this->wire('session')->redirect($this->wire('page')->url);
    }

    return $this->renderApp();
  }

  /**
   * setup/duplicator/api/: JSON operations of the admin app
   */
  public function ___executeApi()
  {
    $api = new DupAdminApi($this->dupmod);
    $this->wire($api);
    $api->handle();
  }

  protected function renderApp()
  {
    $config = $this->wire('config');
    $page = $this->wire('page');
    $csrf = $this->wire('session')->CSRF;
    $moduleUrl = $config->urls->{$this->className};
    $info = self::getModuleInfo();

    $bootstrap = array(
      'version' => $info['version'],
      'api' => $page->url . 'api/',
      'csrf' => array('name' => $csrf->getTokenName(), 'value' => $csrf->getTokenValue()),
      'urls' => array(
        'self' => $page->url,
        'logo' => $moduleUrl . 'Assets/Duplicator-logo-xl-v2.png',
        'nativeSettings' => $config->urls->admin . 'module/edit?name=' . Duplicator::DUP_APPLICATION_NAME . '&collapse_info=1',
        'support' => 'https://processwire.com/talk/topic/15345-duplicator-backup-and-move-sites/',
        'repository' => 'https://github.com/flydev-fr/Duplicator',
      ),
      'canEditSettings' => $this->wire('user')->isSuperuser(),
    );

    $version = rawurlencode($info['version']);
    $config->styles->add($moduleUrl . "Assets/app/duplicator-app.css?v=$version");
    $config->scripts->add($moduleUrl . "Assets/app/duplicator-app.js?v=$version");

    $json = json_encode($bootstrap, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
    return "<script type='application/json' id='duplicator-bootstrap'>$json</script>"
      . "<div id='duplicator-app'><noscript>Duplicator needs JavaScript.</noscript></div>";
  }

  public function ___install()
  {
    parent::___install();
  }

  public function ___uninstall()
  {
    parent::___uninstall();
  }
}
