class DupZipLog
{ //ATO: Utility class to implement some logging into a file per ZIP  
  public $fLog = null;
  public $startTime = 0;
  public $logLevel = 0;

  public $excludeNames = [];
  public $excludeRegEx = [];
  public $excludeExtension = [];
  
  public function log($str)
  {
    if ($this->fLog) {
      fwrite($this->fLog, sprintf("%.1fs: %s\n", microtime(true) - $this->startTime, $str));
    }
  }
  public function verbose($str)
  {
    if ($this->logLevel > 1) {
      $this->log($str);
    }
  }

  public function __construct($logFilename, $logLevel = 1)
  {
    $this->logLevel = $logLevel;
    $logName = $logFilename; // $this->getPath() . basename($zipFilename) . '.log';

    if ($this->logLevel > 0) {
      $this->fLog = fopen($logName, 'w');
      $this->startTime = microtime(true);
      $this->log("Logging {$logName}\n");
    }
  }
  public function __destruct()
  {
    if ($this->fLog) {
      fwrite($this->fLog, sprintf("Done in %.2fs\n", microtime(true) - $this->startTime));
      fclose($this->fLog);
    }
  }
  public function setExcludes($Excludes, $Extensions)
  {
    $exts = array();
    foreach ($Excludes as $excl) {
      $excl = trim($excl);
      if (preg_match('/(\%[^%]+\%)\s*(#\s*(.*))?$/', $excl, $m) === 1) {
        $this->excludeRegEx[] = $m[1];
      }
      // $m[3] would be comment...
      else if (strpos($excl, '*.') === 0) {
        $exts[] = substr($excl, 2);
      } else {
        $this->excludeNames[] = rtrim($excl, '/');
      }
    }
    foreach ($Extensions as $ext) {
      $exts[] = $ext;
    }

    $this->excludeExtension = array_map("strtolower", $exts);
    if ($this->logLevel > 1) {
      $this->log("Exclude Names: " . print_r($this->excludeNames, true));
      $this->log("Exclude Extension: " . print_r($this->excludeExtension, true));
      $this->log("Exclude RegExp: " . print_r($this->excludeRegEx, true));
    }
  }
  public function isExcluded($name)
  {
    if (($ext = pathinfo($name, PATHINFO_EXTENSION)) && in_array(strtolower($ext), $this->excludeExtension)) {
      $this->verbose("Exclude Extension: {$name}");
      return (true);
    }
    if (in_array($name, $this->excludeNames)
      //        || in_array(rtrim($name, '/'), $this->excludeNames)
    ) {
      $this->verbose("Exclude Name: {$name}");
      return (true);
    }
    $bRegMatch = false;
    foreach ($this->excludeRegEx as $rx) {
      if (preg_match($rx, $name, $m) === 1) {
        $this->verbose("Exclude: {$name} matches {$rx}");
        return (true);
      }
    }
    return (false);
  }
}

class Duplicator extends WireData implements Module, ConfigurableModule
{
  const DUP_APPLICATION_NAME = 'Duplicator';
  const DUP_MODULE_VERSION = '1.4.27';
  const DUP_MIN_VERSION = '3.0.34'; // tested - if you have a lower version please test it and report back your result! thanks
  const DUP_LOG_FILENAME = 'duplicator';
  const DUP_SITE_FOLDER = 'site';
  const DUP_DEFAULT_LOCAL_FOLDER = 'backups';
  const DUP_TEMP_FOLDER = 'duplicator-temp';
  const DUP_PACKAGE_EXTENSION = 'package2.zip';
  const DUP_PACKAGE_EXTENSION_SHORT = 'package2';
  const DUP_PACKAGE_MIME_TYPE = 'application/zip';
  const DUP_TIMESTAMP_FORMAT = 'Y-m-d_H-i-s';
  const DUP_WIRETEMP_MAX_TIME = 10 * 60; //ATO: Increased to 10min
  // const DUP_ZIP_FLUSH_MBYTES            = 200;        //ATO: Flush ZIP after quantity of MBytes
  const DUP_ZIP_LOGLEVEL = 2; //ATO: 0:No Logging, otherwise write logfile into output directory 1:Only errors, 2:Verbose info
  const DUP_MAX_PACKAGES = 100;
  const DUP_PHP_MAX_MEMORY = 512;
  const DUP_DB_MAX_TIME = 5000;
  const DUP_PHP_EXECUTION_TIME = 300;
  const DUP_ZIP_FLUSH_TRIGGER = 1000;
  const DUP_MODE_PWAPI = 0;
  const DUP_MODE_NATIVE = 1;
  const DEFAULT_BACKUP_MODE = self::DUP_MODE_PWAPI;

  protected static $_data;

  public static function getModuleInfo()
  {
    $package = json_decode(file_get_contents(__DIR__ . "/package.json"));

    return array(
      'title' => 'Duplicator',
      'version' => $package->version,
      'summary' => 'Back up a whole site (files and database) and move it to another server.',
      'author' => 'flydev',
      'href' => 'https://processwire.com/talk/topic/15345-duplicator-backup-and-move-sites/',
      'singular' => true,
      'autoload' => function () {
        $class = str_replace('ProcessWire\\', '', __CLASS__);
        return ((wire('input')->get->name === $class) !== false && wire('page')->template == 'admin');
      },
      'icon' => 'clone',
      'installs' => 'ProcessDuplicator',
    );
  }

  /**
   * @return array Default value of every setting (used by the admin app)
   */
  public static function getDefaultSettings()
  {
    return self::getDefaultData();
  }

  protected static function getDefaultData()
  {
    return array(
      'path' => '',
      'defaultPath' => '',
      'ignoredPath' => '',
      'backups' => 1,
      'backupSessions' => 1,
      'backupVariants' => 1, //ATO: Image Variants
      'packageName' => '',
      'cycle' => 'everyHour',
      'deadline' => 'never',
      // max number of packages (locally or cloud stored packages)
      'maxPackages' => self::DUP_MAX_PACKAGES,
      'removeBackups' => 1,
      // Advanced options
      'backup_mode' => self::DEFAULT_BACKUP_MODE,
      'chmodPermission' => '0700',
      'shellScript' => '',
      'archiveFlush' => 0,
      'zip_flush_mbytes' => 0,
      // encryption
      'encryptionEnabled' => 0,
      'encryptionPublicKey' => '',
      // CRON mode
      'cronMode' => 'none',
      // storage mode
      'useLocalFolder' => 1,
      'orphanedLogs' => 1,
      'useFTP' => 0,
      'useDropbox' => 0,
      'useGoogleDrive' => 0,
      'useAmazonS3' => 0,
      // FTP
      'ftpHostname' => '',
      'ftpPort' => '',
      'ftpUsername' => '',
      'ftpPassword' => '',
      'ftpDirectory' => '',
      'ftpTimeout' => '',
      'ftpSSL' => 0,
      'ftpPassive' => 1,
      // Dropbox
      'dropboxAccessToken' => '',
      'dropboxAppKey' => '',
      'dropboxAppSecret' => '',
      // Google
      'googleKeyFile' => '',
      'shareWithEmail' => '',
      // Amazon
      'awsAccessKey' => '',
      'awsSecretKey' => '',
      'awsBucketName' => '',
      'awsSubDir' => '',
      'awsRegion' => '',
    );
  }

  /*
     * constructor
     */
  public function __construct()
  {
    $data = $this->wire('modules')->getConfig($this->className);
    $data = array_merge(self::getDefaultData(), $data);
    foreach ($data as $key => $value) {
      $this->$key = $value;
    }

    self::$_data = $this;

    $this->moduleDir = __DIR__;

    $this->defaultPath = wire('config')->paths->assets . self::DUP_DEFAULT_LOCAL_FOLDER;
    if (!is_dir($this->defaultPath) && empty($this->path)) {
      wireMkdir($this->defaultPath);
    }
    $this->ignoredPath = wire('config')->paths->assets . self::DUP_DEFAULT_LOCAL_FOLDER;
    $this->maxPackages = ($this->maxPackages && $this->maxPackages <= self::DUP_MAX_PACKAGES) ? $this->maxPackages : self::DUP_MAX_PACKAGES;
  }

  /*
     * module init
     */
  public function init()
  {

    if ($this->useFTP) {
      require_once __DIR__ . '/Classes/FTPClient.php';
    }

    $file = __DIR__ . '/SDKs/dropbox/autoload.php';
    if (file_exists($file)) {
      require_once /*NoCompile*/ $file;
      require_once __DIR__ . '/Classes/ClientDropbox.php';
    } elseif (class_exists('\Kunnu\Dropbox\DropboxApp')) {
      require_once __DIR__ . '/Classes/ClientDropbox.php';
    }

    $file = __DIR__ . '/SDKs/google-api-php-client-2.2.0/src/Google/autoload.php';
    if (file_exists($file)) {
      require_once /*NoCompile*/ $file;
      require_once __DIR__ . '/Classes/ClientGoogleDrive.php';
    } elseif (class_exists('\Google_Client')) {
      require_once __DIR__ . '/Classes/ClientGoogleDrive.php';
    }

    $file = __DIR__ . '/SDKs/aws/aws-autoloader.php';
    if (file_exists($file)) {
      require_once /*NoCompile*/ $file;
      require_once __DIR__ . '/Classes/ClientAmazonS3.php';
    } elseif (class_exists('\Aws\S3\S3Client')) {
      require_once __DIR__ . '/Classes/ClientAmazonS3.php';
    }

    if (empty($this->path)) {
      $this->path = $this->defaultPath;
    } else if (substr($this->path, 0, 2) == '~/') { //ATO: Expand leading ~/ to $config->paths->root
      $this->path = wire('config')->paths->root . substr($this->path, 2);
    }

    if (!is_dir($this->path) && !empty($this->path)) {
      wireMkdir($this->path);
    }

    if (empty($this->packageName)) {
      $this->packageName = str_replace(['-', ':'], '_', $this->config->httpHost);
    }

    $action = $this->sanitizer->text($this->input->get->action, array('maxLength' => 20));
    // This module autoloads on any admin page requested with ?name=Duplicator, and for a guest
    // every admin URL is the login page, so check who is asking before acting on ?action=.
    // Scheduled backups (LazyCron, PwCron, cron.php) call cronJob() directly and are not affected.
    if ($action && !$this->user->isSuperuser() && !$this->user->hasPermission('duplicator')) {
      $action = '';
    }
    // The two that change something also need this session's token (see actionToken()).
    if (($action === 'backup_now' || $action === 'clean_packages') && !self::hasActionToken()) {
      $action = '';
    }
    switch ($action) {
      case 'backup_now': {
          $e = new HookEvent();
          $result = $this->cronJob($e);
          //$this->session->redirect($this->config->urls->admin . 'module/edit?name=' . $this->className . '&collapse_info=1');
          break;
        }

      case 'clean_packages':
        DUP_Util::clean($this->path, 0);
        break;

      case 'none':
        break;

      case 'warning': {
          if (!empty($this->input->get->msg)) {
            $this->warning(($this->sanitizer->text($this->input->get->msg)));
          }

          break;
        }

      case 'error': {
          $this->error(($this->sanitizer->text($this->input->get->msg)));
          break;
        }

      case 'view_listing':
        echo $this->renderModalPackagesFound();
        break;

      default:
        break;
    }

    switch ($this->cronMode) {
      case 'LazyCron':
        if (!$this->modules->isInstalled('LazyCron')) {
          $this->warning('You must install the core module LazyCron .');
        } else {
          if ($this->cycle == 'logoutTrigger') {
            $this->addHookBefore("Session::logout", function () {
              if (!$this->wire('user')->hasPermission('duplicator')) {
                return;
              }

              $e = new HookEvent();
              $this->cronJob($e);
            });
          } elseif ($this->cycle == 'submitTrigger') {
            $this->addHookBefore("InputfieldSubmit::processInput", function (HookEvent $event) {
              if (!$this->wire('user')->hasPermission('duplicator')) {
                return;
              }

              $e = new HookEvent();
              $this->cronJob($e);
            });
          } elseif ($this->cycle) {
            $this->addHook("LazyCron::{$this->cycle}", $this, 'cronJob');
          }
        }
        break;

      case 'PWCron':
        if (!$this->modules->isInstalled('PwCron')) {
          $this->warning("You must install the module PWCron. Please read the duplicator's readme");
        } else {
          $this->addHook('PwCron::cronHook', $this, 'cronJob');
        }
        break;

      case 'none':
      default:
        break;
    }
  }

  /*
     * module ready
     */
  public function ready()
  {
  }

  /*
     * module install
     */
  public function ___install()
  {
    if (version_compare($this->config->version, self::DUP_MIN_VERSION, '<')) {
      throw new WireException("This module requires ProcessWire " . self::DUP_MIN_VERSION . " or newer.");
    }
  }

  /*
     * module uninstall
     */
  public function ___uninstall()
  {
    // uninstall ProcessDuplicator if installed
    if ($this->modules->isInstalled('ProcessDuplicator')) {
      $this->modules->uninstall('ProcessDuplicator');
    }

    $path = str_replace($this->config->paths->root, '/', $this->path);
    $this->warning("Please note that packages files in {$path} remain. You may remove them manually.");
  }

  public function ___upgrade($fromVersion, $toVersion) {
    // Show a warning if previous installed version was configured using native_mode about this previous setting
    if ($this->modules->isInstalled('Duplicator') && $this->modules->get('Duplicator')->backup_mode == 'MODE_NATIVE') {
      $this->modules->saveConfig(self::class, 'backup_mode', self::DUP_MODE_NATIVE);
      if ($this->backup_mode == self::DUP_MODE_NATIVE) {
        $this->message("The **previous version** of Duplicator was configured using `native_mode`. Please note that the value of this setting has changed. The change **is already applied** to your current configuration.", Notice::allowMarkdown);
      }
      else {
        $this->warning("The **previous version** of Duplicator was configured using `native_mode`. Please note that the value of this setting has changed. You need to set the backup mode to `Native mode` and **save the settings**.", Notice::allowMarkdown);
      }
    }
  }

  public static function getPath()
  {
    return self::$_data['path'];
  }

  /**
   * The query-string pair ("name=value") that the links and buttons which change something
   * carry: starting a backup and deleting packages are plain GET requests, so without it a
   * link on any other site, followed by a logged-in admin, would run them.
   */
  public static function actionToken()
  {
    $csrf = wire('session')->CSRF;
    return $csrf->getTokenName() . '=' . $csrf->getTokenValue();
  }

  /**
   * Does the request carry this session's token in its query string?
   */
  public static function hasActionToken()
  {
    $csrf = wire('session')->CSRF;
    $given = wire('input')->get($csrf->getTokenName());
    return is_string($given) && hash_equals((string) $csrf->getTokenValue(), $given);
  }

  /*
     * build a ZIP file containing the ProcessWire structure
     * return the ZIP file
     */
  protected function buildProcessWireBackup($options = array())
  {
    $defaultOptions = array(
      //ATO: Generate ZIP in final folder and name it package2.zip
      'filename' => DUP_Util::formatFilename($this->packageName, 'package2.zip'),
      'folder' => $this->path . '/',
      'exclude' => array(),
      'extension' => array(),
      'allowHidden' => true,
    );
    $options = array_merge($options, $defaultOptions);

    $root = wire('config')->paths->root;
    $excludeRoot = '/';
    $assetsPath = $excludeRoot . self::DUP_SITE_FOLDER . '/' . basename(wire('config')->paths->assets) . '/';
    array_push($options['exclude'], $assetsPath . 'cache' . '/' . 'WireTempDir');
    if ($this->backupWire) {
      array_push($options['exclude'], '/wire');
    }

    if ($this->backups) {
      array_push($options['exclude'], $assetsPath . 'backups');
    }

    if ($this->backupLogs) {
      array_push($options['exclude'], $assetsPath . 'logs');
    }

    if ($this->backupCache) {
      array_push($options['exclude'], $assetsPath . 'cache');
    }

    if ($this->backupSessions) {
      array_push($options['exclude'], $assetsPath . 'sessions');
    }

    if ($this->backupVariants) {
      array_push($options['exclude'], '%\.\d+x\d+\.[^/]+$%');
    }
    //ATO: Image Variants created by PW
    if ($this->backupFiles) {
      array_push($options['exclude'], $assetsPath . 'files');
    }

    $excluded = preg_split('/\r\n|[\r\n]/', $this->ignoredPath);
    $options['exclude'] = array_merge($options['exclude'], $excluded);

    foreach ($this->ignoredExtensions as $ignoredExtension) {
      $validExt = substr(strchr($ignoredExtension, '.'), 1);
      if (!empty($validExt)) {
        array_push($options['extension'], $validExt);
      }
    }

    if (!is_dir($options['folder']) || !is_writable($options['folder'])) {
      DUP_Logs::log('- could not create temporary directory: ' . $options['folder']);
      return false;
    }

    $fileinfo['zipfile'] = $options['folder'] . $options['filename'];
    $fileinfo['zipname'] = basename($fileinfo['zipfile']);
    $zipinfo = $this->zipData2($fileinfo['zipfile'], $root, $options); //ATO: Use reworked implementation
    $fileinfo['structure'] = $zipinfo['zipfile'];

    if (!file_exists($fileinfo['structure'])) {
      DUP_Logs::log("- an error occured while building the ProcessWire structure: ");
      DUP_Logs::log(json_encode($fileinfo['zipfile'], JSON_PRETTY_PRINT));
      DUP_Logs::log(" root: " . $root . "\n" . json_encode($options, JSON_PRETTY_PRINT ));
      return false;
    }

    return $zipinfo;
  }

  /*
     * backup the database
     * return the ZIP file containing the SQL file
     */
  protected function buildDatabaseBackup(array $options = array())
  {
    $defaultOptions = array(
      'path' => wireTempDir(self::DUP_TEMP_FOLDER),
      'backup' => array(
        'filename' => DUP_Util::formatFilename(wire('config')->dbName, 'sql'),
        'description' => '', //$this->backupFileinfo(),
        'maxSeconds' => self::DUP_WIRETEMP_MAX_TIME,
      ),
      'chmodPermission' => $this->chmodPermission,
      'shellScript' => $this->shellScript,
    );

    $options = array_merge($options, $defaultOptions);
    $dbBackup = new BackupDatabase($options);
    $zipobj = $dbBackup->setDatabase($this->database)->setMode((int)$this->backup_mode);
    $zipfile = $zipobj->getZip();
    if (file_exists($zipfile)) {
      $fileinfo['zipfile'] = $zipfile;
      $fileinfo['zipname'] = basename($zipfile);
      $fileinfo['sqlsize'] = $zipobj->getSize();
      return $fileinfo;
    }

    return false;
  }

  /*
     * build the package
     * return a ZIP file containing the database and ProcessWire stucture zipped files
     * TODO: better management for future use in deployment
     */
  protected function buildPackage(array $options = array())
  {
    DUP_Util::timer('build');

    $defaultOptions = array(
      'filename' => DUP_Util::formatFilename(str_replace('-', '_', $this->packageName), 'package.zip'),
      'path' => $this->path,
    );
    $options = array_merge($options, $defaultOptions);
    $packageInfos = array();

    try {
      // files first: the dump lives in a temporary folder that ProcessWire removes after
      // DUP_WIRETEMP_MAX_TIME, which a long file archive could outlast
      $pwbackup = $this->buildProcessWireBackup();
      if ($pwbackup == false) {
        DUP_Logs::log("- an error occured during package build.");
        return false;
      }
      $packageInfos['pw'] = $pwbackup;

      $dbbackup = $this->buildDatabaseBackup();
      if ($dbbackup == false) {
        DUP_Logs::log("- an error occured during database backup.");
        DUP_Util::deleteFile($pwbackup['zipfile']);
        return false;
      }
      $packageInfos['db'] = $dbbackup;

      if (true) //ATO: Add SQL ZIP to archive
      {
        $zip = new \ZipArchive();
        if ($zip->open($pwbackup['zipfile']) !== true) {
          throw new WireException("Unable to open ZIP: {$pwbackup['zipfile']}");
        }

        // a package without its database cannot be restored: check the dump really is in it
        $dumpName = basename($dbbackup['zipfile']);
        $added = is_file($dbbackup['zipfile']) && $zip->addFile($dbbackup['zipfile'], $dumpName);
        $closed = $zip->close();
        if ($added && $closed) {
          $added = $zip->open($pwbackup['zipfile']) === true && $zip->locateName($dumpName) !== false;
          $zip->close();
        }
        DUP_Util::deleteFile($dbbackup['zipfile']);
        if (!$added || !$closed) {
          DUP_Logs::log("- the database dump could not be added to the package, it was deleted.");
          DUP_Util::deleteFile($pwbackup['zipfile']);
          return false;
        }
        $zipfile = $pwbackup['zipfile']; //ATO: Fix to properly return new archive
      } else {
        $files = array(
          $packageInfos['db']['zipfile'],
          $packageInfos['pw']['zipfile'],
        );
        $zipfile = $options['path'] . DS . $options['filename'];
        $result = wireZipFile($zipfile, $files);
        foreach ($files as $file) {
          DUP_Util::deleteFile($file);
        }
        foreach ($result['errors'] as $error) {
          DUP_Logs::log("ZIP add failed: $error");
        }
      }

      if (file_exists($zipfile)) {
        $package['zipfile'] = $zipfile;
        $package['size'] = filesize($zipfile);
        $package['info'] = $packageInfos;
        //$fp = fopen($options['path'] . DS . $options['filename'] . '.json', 'w');
        //fwrite($fp, json_encode($package));
        //fclose($fp);
        DUP_Logs::log("- package built successfully in " . DUP_Util::timer('build') . "sec");
        return $package;
      } else {
        DUP_Logs::log("- package build failed, {$zipfile} doesn't exist");
        return false;
      }
    } catch (\Exception $ex) {
      DUP_Logs::log($ex->getMessage());
    }

    return false;
  }



  /**
   * Encrypt a package in place with the public key from the settings
   *
   * The encrypted package keeps its name, so listings and retention rules work as before.
   * The installer recognizes encrypted packages and asks for the secret key.
   *
   * @param string $zipfile
   * @return bool False if the package could not be encrypted (the plain package is left untouched)
   */
  protected function encryptPackage($zipfile)
  {
    DUP_Logs::log('- package encryption starting...');
    DUP_Util::timer('encryption');
    // hidden temporary name: it does not look like a package, so it is never listed nor uploaded
    $encrypted = dirname($zipfile) . DS . self::ENCRYPTION_TEMP_PREFIX . bin2hex(random_bytes(8)) . '.tmp';
    try {
      DupCrypto::encryptFile($zipfile, $encrypted, $this->encryptionPublicKey);
      // rename() replaces the plain package with the encrypted one
      if (!rename($encrypted, $zipfile)) {
        throw new \RuntimeException("could not replace the package with its encrypted version");
      }
    } catch (\Exception $e) {
      @unlink($encrypted);
      DUP_Logs::log('- package encryption failed: ' . $e->getMessage(), 'error');
      return false;
    }
    DUP_Logs::log('- package encrypted in ' . DUP_Util::timer('encryption') . 'sec');
    return true;
  }

  /**
   * Prefix of the temporary files written while encrypting a package
   */
  const ENCRYPTION_TEMP_PREFIX = '.dup-encrypting-';

  /**
   * When encryption is on, make sure no plain package survives a job that does not finish
   *
   * A timeout or a fatal error during the build or the encryption is not an exception:
   * the shutdown function then removes the plain packages written by this job.
   *
   * @param bool $done Set to true by the job once it has finished
   */
  protected function guardPlainPackages(&$done)
  {
    $path = $this->path;
    if (empty($path) || !is_dir($path)) return;
    $start = time() - 1;
    $extension = '.' . self::DUP_PACKAGE_EXTENSION;
    // leftovers of a previous job that did not finish
    foreach (glob($path . DS . self::ENCRYPTION_TEMP_PREFIX . '*.tmp') ?: array() as $file) @unlink($file);
    register_shutdown_function(function () use (&$done, $path, $start, $extension) {
      if ($done) return;
      foreach (scandir($path) ?: array() as $file) {
        $filename = $path . DS . $file;
        if (strpos($file, self::ENCRYPTION_TEMP_PREFIX) === 0) {
          @unlink($filename);
        } else if (substr($file, -strlen($extension)) === $extension && @filemtime($filename) >= $start && !DupCrypto::isEncryptedFile($filename)) {
          @unlink($filename);
        }
      }
    });
  }

  /*
  * call this function from a cron tool to launch the backup task
  */
  public function ___cronJob()
  {
    if (!$this->useLocalFolder && !$this->useDropbox && !$this->useGoogleDrive && !$this->useAmazonS3 && !$this->useFTP) {
      return false;
    }

    DUP_Util::timer('job');
    //ignore_user_abort(true);
    DUP_Util::setMemoryLimit(self::DUP_PHP_MAX_MEMORY);
    DUP_Util::setMaxExecutionTime(self::DUP_PHP_EXECUTION_TIME);

    $jobDone = false;
    if ($this->encryptionEnabled) $this->guardPlainPackages($jobDone);

    $package = $this->buildPackage();

    // when encryption is on, a package that could not be encrypted is never stored nor uploaded
    if (is_array($package) && $package['zipfile'] !== null && $this->encryptionEnabled) {
      if ($this->encryptPackage($package['zipfile'])) {
        $package['size'] = filesize($package['zipfile']);
      } else {
        DUP_Util::deleteFile($package['zipfile']);
        DUP_Logs::log("- package deleted: encryption is enabled but the package could not be encrypted", 'error');
        $package = false;
      }
    }

    if (is_array($package) && $package['zipfile'] !== null) {
      $packageName = basename($package['zipfile']);
      if ($this->useLocalFolder) {
        if (file_exists($package['zipfile'])) {
          DUP_Logs::log("- package saved in local folder: $packageName", 'message');
        } else {
          DUP_Logs::log("An error occured.");
        }
      }

      if ($this->useFTP) {
        try {
          $ftp = new FTPClient();
          $ftp->setHost($this->ftpHostname);
          $ftp->setPort(empty($this->ftpPort) ? 21 : $this->ftpPort);
          $ftp->setUser($this->ftpUsername);
          $ftp->setPassword($this->ftpPassword);
          $ftp->setTimeout(empty($this->ftpTimeout) ? 90 : $this->ftpTimeout);
          ($this->ftpSSL == true) ? $ftp->ssl_connect() : $ftp->connect();
          $ftp->login();
          $ftp->pasv($this->ftpPassive);
          $ftp->setPath($this->ftpDirectory);
          $ftp->upload(basename($package['zipfile']), $package['zipfile'], $this->ftpDirectory);
          $ftp->deleteOldBackups($this->maxPackages, $this->deadline);
          $ftp->disconnect();
          DUP_Logs::log("- [FTP] package uploaded successfully: $packageName", 'message');
        } catch (FTPClientException $ex) {
          if (@is_resource($ftp)) {
            $ftp->disconnect();
          }

          DUP_Logs::log("[FTP] error: " . $ex->getMessage(), 'error');
        }
      }

      if ($this->useDropbox) {
        try {
          if (!class_exists('\Kunnu\Dropbox\DropboxClient')) {
            throw new WireException("Dropbox SDK not installed.");
          }

          $dropbox = new \DropboxClient();
          $dropbox->setAccessToken($this->dropboxAccessToken);
          $dropbox->setIdentifier("Duplicator/1");
          $dropbox->setFolder(self::DUP_APPLICATION_NAME);
          $dropbox->setQuery(self::DUP_PACKAGE_EXTENSION);
          $dropbox->setMimeType(self::DUP_PACKAGE_MIME_TYPE);
          $dropbox->setMaxPackages($this->maxPackages);
          if ($dropbox->upload($package['zipfile'])) {
            DUP_Logs::log("[Dropbox] package uploaded successfully: $packageName");
          } else {
            throw new \DropBoxClientException("An error occured while uploading the package: {$packageName}");
          }
          $dropbox->deleteOldBackups($this->maxPackages, $this->deadline);
        } catch (\Exception $ex) {
          DUP_Logs::log("[Dropbox] error: " . $ex->getMessage(), 'error');
        }
      }

      if ($this->useGoogleDrive) {
        try {
          if (!class_exists('\Google_Client')) {
            throw new WireException("GoogleDrive SDK not installed.");
          }

          $google = new GoogleDriveClient();
          $google->setTempFolder(self::DUP_TEMP_FOLDER);
          $google->setAppName(self::DUP_APPLICATION_NAME);
          $google->setGoogleKeyFile($this->googleKeyFile);
          $google->setShareWithEmail($this->shareWithEmail);
          $google->setMaxPackages($this->maxPackages);
          $google->connect();
          $google->upload($package['zipfile']);
          $files = $google->getPackages(self::DUP_PACKAGE_EXTENSION, self::DUP_PACKAGE_MIME_TYPE, $this->deadline);
          if (is_array($files) && count($files)) {
            $google->deleteFiles($files);
          }
        } catch (\Exception $ex) {
          DUP_Logs::log("- [GoogleDrive] error: " . $ex->getMessage(), 'error');
        }
      }

      if ($this->useAmazonS3) {
        try {
          if (!class_exists('\Aws\S3\S3Client')) {
            throw new WireException("AmazonS3 SDK not installed.");
          }

          $amazonaws = new AmazonS3Client();
          $amazonaws->setAccessKey($this->awsAccessKey);
          $amazonaws->setSecretKey($this->awsSecretKey);
          $amazonaws->setRegion($this->awsRegion);
          $amazonaws->setBucket($this->awsBucketName);
          $buckets = $amazonaws->getBuckets();
          $bucketExist = false;
          foreach ($buckets as $bucket) {
            if (strcmp($bucket, $this->awsBucketName) === 0) {
              $bucketExist = true;
              break;
            }
          }
          if (!$bucketExist) {
            $amazonaws->createBucket($this->awsBucketName);
          }

          $amazonaws->upload($package['zipfile'], $packageName, $this->awsSubDir);
          //if($url === null) throw new AmazonS3ClientException("AmazonS3: An error occured while uploading package <{$packageName}>");
          $amazonaws->deleteOldBackups($this->maxPackages, $this->deadline);
        } catch (AmazonS3ClientException $ex) {
          DUP_Logs::log("[AmazonS3] error: " . $ex->getMessage(), 'warning');
        }
      }

      if (!empty($this->deadline) || $this->maxPackages <= DUP_Util::getTotalPackages(self::$_data->path, self::DUP_PACKAGE_EXTENSION) && DUP_Util::getTotalPackages(self::$_data->path, self::DUP_PACKAGE_EXTENSION) != 0) {
        /// decide if we should clean orphaned log files
        $cleanOrphanedLogFiles = ($this->useLocalFolder == true && $this->orphanedLogs == 1) ? true : false;
        // log a message if `useLocalFolder` is true, but `orphanedLogs` is false
        if ($this->useLocalFolder == true && !$cleanOrphanedLogFiles) {
          DUP_Logs::log("- orphaned log files not cleaned (disabled by settings)");
        }
        $removed = count(DUP_Util::clean(self::$_data->path, $this->maxPackages, strtotime("-{$this->deadline}"), $cleanOrphanedLogFiles));
        if ($removed > 0) {
          DUP_Logs::log(sprintf("- deleted %d local package%s", $removed, ($removed > 1) ? 's' : ''));
        }
      }

      if ($this->removeBackups && !$this->useLocalFolder) {
        if ($this->useAmazonS3) {
          // fix: https://github.com/aws/aws-sdk-php/issues/841
          // garbage collector's buffer filled, force cycles
          gc_collect_cycles();
        }
        DUP_Util::deleteFile($package['zipfile']);
      }
    } else {
      DUP_Logs::log("- package build failed.");
      return null;
    }

    $jobDone = true;
    DUP_Logs::log("- job finished in " . DUP_Util::timer('job') . "sec");
    return true;
  }

  //ATO: Optimized, non-recursive archiver
  /**
   * zipData2 - Archive directory tree into a ZIP
   * This implementation starts from a root directory and operates on an
   * array of pending directories.
   * Per iteration the first entry is shifted out of the array and processes
   * its directory. Each entry is checked against the exclusion lists and
   * either unshifted into the array, in case it is a directory, or archived
   * into the ZIP.
   * Iteration ends when the array is empty.
   * To avoid lengthy operation on ZipArchive::close, the archive is flushed
   * after some 100MBytes.
   *
   */
  public function zipData2($zipfile, $rootDirectory, array $options = array())
  {
    wire('log')->message($zipfile);
    if (!is_string($zipfile)) {
      throw new WireException("Invalid zipfile argument");
    }

    if (!class_exists('\ZipArchive')) {
      throw new WireException("PHP's ZipArchive class does not exist");
    }

    $zippath = dirname($zipfile);
    if (!is_dir($zippath)) {
      throw new WireException("Path for ZIP file ($zippath) does not exist");
    }

    if (!is_writable($zippath)) {
      throw new WireException("Path for ZIP file ($zippath) is not writable");
    }

    if (!is_dir($rootDirectory)) {
      throw new WireException("Invalid Root Directory {$rootDirectory} to add to ZIP file $zipfile");
    }

    if (is_file($zipfile) && $options['overwrite'] && !unlink($zipfile)) {
      throw new WireException("Unable to overwrite $zipfile");
    }

    if (!is_array($options['exclude'])) {
      $options['exclude'] = array($options['exclude']);
    }

    $options = array_merge([
      'allowHidden' => true,
      'allowEmptyDirs' => true,
      'overwrite' => false,
      'maxDepth' => 0,
      //            'exclude' => array(), // files or dirs to exclude
      //            'dir' => '',
      //            'zip' => null, // internal use: holds ZipArchive instance for recursive use
    ], $options);

    $zip = new \ZipArchive();
    if ($zip->open($zipfile, \ZipArchive::CREATE) !== true) {
      throw new WireException("Unable to create ZIP: $zipfile");
    }

    $zipLog = new DupZipLog($this->getPath() . '/' . basename($zipfile) . '.log', self::DUP_ZIP_LOGLEVEL);

    // true allows every hidden file (.htaccess, .user.ini, .well-known...), an array only the listed names
    $allowAllHidden = isset($options['allowHidden']) && $options['allowHidden'] === true;
    $allowHidden = isset($options['allowHidden']) && is_array($options['allowHidden']) ? $options['allowHidden'] : [];

    // symbolic links: see DupFileFilter::checkLink()
    $siteRoot = realpath($rootDirectory) ?: $rootDirectory;
    $followedLinks = [];
    $skippedLinks = [];

    $zipLog->setExcludes($options['exclude'], $options['extension']);

    $ret = ['files' => [], 'errors' => []];

    $totalFiles = 0;
    $totalDirectories = 0;
    $totalBytes = 0;

    $fragmentBytes = 0;

    $extSizes = [];
    $rootDirectory = rtrim($rootDirectory, '/'); // Ensure its NOT terminated

    $dirsToProcess = ['/']; // Start at root

    if ($this->cronMode !== 'none') {
      DUP_Logs::log("- running ZipData2() with cronMode = {$this->cronMode}");
      DUP_Logs::log("- trying to allow longer execution time");
      set_time_limit(300); // Try to allow longer execution time
      DUP_Logs::log("- php time limit => " . ini_get('max_execution_time') . " sec");
    }

    while ($thisDir = array_shift($dirsToProcess)) { // Process first entry in array
      $fullPath = $rootDirectory . $thisDir;

      if (!is_dir($fullPath)) { // Something went badly wrong!
        $zipLog->log("NOT A DIRECTORY: {$fullPath}");
        continue;
      }

      $totalDirectories += 1;
      $zipLog->verbose("DIR: {$fullPath}");

      $dirFiles = []; // Collect files from this directory

      if (($dh = opendir($fullPath)) !== false) {
        while (($de = readdir($dh)) !== false) {
          if ($de[0] == '.') // Something special?
          {
            // Check for allowed hidden files
            if (($de == '.') || ($de == '..')) // NEVER!
            {
              continue;
            }

            if (!$allowAllHidden && !in_array($de, $allowHidden, true)) {
              $zipLog->verbose("HIDDEN: {$thisDir}{$de}");
              continue;
            }
          }

          if (DupFileFilter::isSkippedName($de)) {
            $zipLog->verbose("SKIPPED: {$thisDir}{$de}");
            continue;
          }

          $filePath = $fullPath . $de;
          if ($zipLog->isExcluded($thisDir . $de)) {
            continue;
          }

          // checked before is_dir(), which follows the link and warns outside open_basedir
          if (DupFileFilter::isLink($filePath)) {
            list($reason) = DupFileFilter::checkLink($filePath, $siteRoot, $followedLinks);
            if ($reason !== null) {
              $zipLog->log("SKIPPED LINK: {$thisDir}{$de} ({$reason})");
              $skippedLinks[] = "{$thisDir}{$de} ({$reason})";
              continue;
            }
          }

          if (is_dir($filePath)) {
            //                        $zipLog->log("PUSH: ".$thisDir . $de . '/');
            array_unshift($dirsToProcess, $thisDir . $de . '/'); // Insert new directories at the head
          } else if (file_exists($filePath)) {
            //                        $zipLog->log("PREP: {$de}");
            $dirFiles[] = $de;
          } else {
            // ERROR
            $zipLog->log("MISSING: {$filePath}");
          }
        }
        closedir($dh);

        $relPath = substr($thisDir, 1);
        if (count($dirFiles) > 0) {
          $zip->addEmptyDir($relPath);
          foreach ($dirFiles as $file) {
            $filePath = $fullPath . $file;
            if (
              file_exists($filePath)
              && $zip->addFile($filePath, $relPath . $file)
            ) {
              $ret['files'][] = $filePath;
              $fileSize = filesize($filePath);
              $totalFiles += 1;
              $totalBytes += $fileSize;

              if ($ext = pathinfo($file, PATHINFO_EXTENSION)) {
                if (!isset($extSizes[$ext])) {
                  $extSizes[$ext] = 0;
                }

                $extSizes[$ext] += $fileSize;
              }
              $zipLog->verbose("ZIP: {$thisDir}{$file}");

              $fragmentBytes += $fileSize;
              if (($this->zip_flush_mbytes > 0) && ($fragmentBytes >= /* self::DUP_ZIP_FLUSH_MBYTES */ $this->zip_flush_mbytes * 1024 * 1024)) {
                $zipLog->verbose("CLOSING ZIP: {$zipfile}");
                $zip->close();
                $zipLog->verbose("OPENING ZIP: {$zipfile}");
                if ($zip->open($zipfile) !== true) {
                  throw new WireException("Unable to re-open ZIP: $zipfile");
                }

                $zipLog->verbose("OPENED ZIP: {$zipfile}");
                $fragmentBytes = 0;
                if ($this->cronMode !== 'none') {
                  DUP_Logs::log("- running ZipData2() with cronMode = {$this->cronMode}");
                  DUP_Logs::log("- trying to allow longer execution time");
                  set_time_limit(300); // Try to allow longer execution time
                  DUP_Logs::log("- php time limit => " . ini_get('max_execution_time') . " sec");
                }
              }
            } else {
              $ret['errors'][] = $filePath;
              $zipLog->log("NOTEXIST: {$filePath}");
            }
          }
        } else {
          // Empty directory
          $zipLog->verbose("EMPTY: {$fullPath}");
          if ($options['allowEmptyDirs']) {
            $zip->addEmptyDir($relPath);
          }
        }
      } else {
        $zipLog->log("NODIR: {$fullPath}");
        // ERROR
      }
    }

    if (count($skippedLinks)) {
      DUP_Logs::log("- " . count($skippedLinks) . " symbolic link(s) not packaged: " . implode(', ', array_slice($skippedLinks, 0, 10)) . (count($skippedLinks) > 10 ? ', ...' : ''));
    }
    $zipLog->log("{$totalFiles} Files in {$totalDirectories} Directories: " . sprintf("%.2fMB", $totalBytes / (1024 * 1024)));
    if ($zipLog->logLevel >= 2) {
      arsort($extSizes);
      foreach ($extSizes as $ext => $siz) {
        $zipLog->verbose(sprintf("%s: %.2fMB", $ext, $siz / (1024 * 1024)));
      }
    }

    $zipLog->log("CLOSING ZIP: {$zipfile}");
    $zip->close();
    $ret['zipfile'] = $zipfile;
    $zipLog = null; // Clean up instance

    return ($ret);
  }

  public function zipData($zipfile, $files, array $options = array())
  {
    static $depth = 0;
    $defaults = array(
      'allowHidden' => true,
      'allowEmptyDirs' => true,
      'overwrite' => false,
      'maxDepth' => 0,
      'exclude' => array(), // files or dirs to exclude
      'dir' => '',
      'zip' => null, // internal use: holds ZipArchive instance for recursive use
    );
    $return = array(
      'files' => array(),
      'errors' => array(),
    );

    if (!empty($options['zip']) && !empty($options['dir']) && $options['zip'] instanceof \ZipArchive) {
      // internal recursive call
      $recursive = true;
      $zip = $options['zip']; // ZipArchive instance
    } else if (is_string($zipfile)) {
      if (!class_exists('\ZipArchive')) {
        throw new WireException("PHP's ZipArchive class does not exist");
      }

      $options = array_merge($defaults, $options);
      $zippath = dirname($zipfile);
      if (!is_dir($zippath)) {
        throw new WireException("Path for ZIP file ($zippath) does not exist");
      }

      if (!is_writable($zippath)) {
        throw new WireException("Path for ZIP file ($zippath) is not writable");
      }

      if (empty($files)) {
        throw new WireException("Nothing to add to ZIP file $zipfile");
      }

      if (is_file($zipfile) && $options['overwrite'] && !unlink($zipfile)) {
        throw new WireException("Unable to overwrite $zipfile");
      }

      if (!is_array($files)) {
        $files = array($files);
      }

      if (!is_array($options['exclude'])) {
        $options['exclude'] = array($options['exclude']);
      }

      $recursive = false;
      $zip = new \ZipArchive();
      if ($zip->open($zipfile, \ZipArchive::CREATE) !== true) {
        throw new WireException("Unable to create ZIP: $zipfile");
      }
    } else {
      throw new WireException("Invalid zipfile argument");
    }
    $dir = strlen($options['dir']) ? rtrim($options['dir'], '/') . '/' : '';
    foreach ($files as $file) {
      $basename = basename($file);
      $name = $dir . $basename;
      $name = str_replace(DS, '/', $name);
      if ($basename[0] == '.' && $recursive) {
        if (!$options['allowHidden']) {
          continue;
        }

        if (is_array($options['allowHidden']) && !in_array($basename, $options['allowHidden'])) {
          continue;
        }
      }
      if (count($options['exclude'])) {
        if (!is_readable($name) && in_array($name, $options['exclude'])) {
          continue;
        }
        if (in_array($name, $options['exclude']) || in_array("$name/", $options['exclude'])) {
          continue;
        }
      }
      $file = str_replace(DS, '/', $file);
      if (count($options['exclude'])) {
        if (
          !is_readable($file) ||
          in_array($file, $options['exclude']) ||
          in_array(pathinfo($file, PATHINFO_EXTENSION), $options['extension'])
        ) {
          continue;
        }
        if (in_array($name, $options['exclude']) || in_array("$name/", $options['exclude'])) {
          continue;
        }
      }
      if (is_dir($file)) {
        if ($options['maxDepth'] > 0 && $depth >= $options['maxDepth']) {
          continue;
        }

        $_files = array();
        foreach (new \DirectoryIterator($file) as $f) {
          if ($f->isDot()) {
            continue;
          }

          if (!$f->isReadable() || !$f->isWritable()) {
            continue;
          }
          if ($options['maxDepth'] > 0 && $f->isDir() && ($depth + 1) >= $options['maxDepth']) {
            continue;
          }

          $_files[] = str_replace(DS, '/', $f->getPathname());
        }
        if (count($_files)) {
          $zip->addEmptyDir($name);
          $options['dir'] = "$name/";
          $options['zip'] = $zip;
          $depth++;
          $_return = $this->zipData($zipfile, $_files, $options);
          $depth--;
          foreach ($_return['files'] as $s) {
            $return['files'][] = $s;
          }

          foreach ($_return['errors'] as $s) {
            $return['errors'][] = $s;
          }
        } else if ($options['allowEmptyDirs']) {
          $zip->addEmptyDir($name);
        }
      } else if (file_exists($file)) {
        if ($zip->addFile($file, $name)) {
          $return['files'][] = $name;
        } else {
          $return['errors'][] = $name;
        }
      }
    }
    if (!$recursive) {
      $zip->close();
    }

    $return['zipfile'] = $zipfile;
    return $return;
  }
  /**
   * Settings form of Modules > Configure > Duplicator
   *
   * The admin app (Setup > Duplicator > Settings) shows the same settings with its own layout,
   * and validates them with these Inputfields: keep names, values and options in sync with
   * ui/src/SettingsView.tsx.
   */
  public static function getModuleConfigInputfields(array $data)
  {
    $data = array_merge(self::getDefaultData(), $data);
    $config = wire('config');
    $modules = wire('modules');
    $fields = new InputfieldWrapper();

    $appUrl = $config->urls->admin . 'setup/' . strtolower(self::DUP_APPLICATION_NAME) . '/#/settings';
    $field = $modules->get('InputfieldMarkup');
    $field->markupText = "<p id='dup-app-link'>" . __('These settings are easier to manage in the Duplicator app.') . " <a href='" . htmlspecialchars($appUrl, ENT_QUOTES, 'UTF-8') . "'>" . __('Open Setup > Duplicator > Settings') . "</a></p>";
    $fields->add($field);

    // ---- Package
    $fs = $modules->get('InputfieldFieldset');
    $fs->label = __('Package');
    $fs->icon = 'archive';
    $fs->description = __('A package is a ZIP of the site files and its database dump.');

    $defaultName = str_replace(array('-', ':'), '_', (string) $config->httpHost);
    $field = $modules->get('InputfieldText');
    $field->attr('name', 'packageName');
    $field->label = __('File name');
    $field->description = sprintf(__('Packages are named `date-name.%s`. Leave empty to use `%s`.'), self::DUP_PACKAGE_EXTENSION, $defaultName);
    $field->attr('placeholder', $defaultName);
    $field->attr('value', (string) $data['packageName']);
    $fs->append($field);

    $leaveOut = $modules->get('InputfieldFieldset');
    $leaveOut->label = __('Leave out of packages');
    $leaveOut->description = __('Everything in the site folder is included, except what is checked here. The database is always included.');
    $parts = array(
      'backupWire' => array(__('ProcessWire core'), __('The wire/ folder. Keep it to restore on an empty server.')),
      'backupFiles' => array(__('Uploaded files'), __('site/assets/files: the images and documents of your pages.')),
      'backupVariants' => array(__('Image variations'), __('Resized copies of images. ProcessWire creates them again when needed.')),
      'backupLogs' => array(__('Logs'), 'site/assets/logs'),
      'backupCache' => array(__('Cache'), __('site/assets/cache. Rebuilt automatically.')),
      'backupSessions' => array(__('Sessions'), __('site/assets/sessions. Restoring them logs users back in.')),
      'backups' => array(__('Previous packages'), __('site/assets/backups. Each package would otherwise contain all the older ones.')),
    );
    foreach ($parts as $name => $texts) {
      $cb = $modules->get('InputfieldCheckbox');
      $cb->attr('name', $name);
      $cb->label = $texts[0];
      $cb->description = $texts[1];
      $cb->columnWidth = 50;
      $cb->attr('checked', !empty($data[$name]) ? 'checked' : '');
      $leaveOut->append($cb);
    }
    $fs->append($leaveOut);

    $f = $modules->get('InputfieldAsmSelect');
    $f->attr('name', 'ignoredExtensions');
    $f->label = __('Excluded file types');
    $f->description = __('Files with these extensions are left out.');
    $f->addOptions(array(
      '*.pdf' => 'PDF',
      '*.mp3' => 'MP3',
      '*.jpg' => 'JPG',
      '*.png' => 'PNG',
      '*.zip' => 'ZIP',
      '*.tar' => 'TAR',
      '*.gz' => 'TAR GUNZIP',
      '*.tgz' => 'TGZ',
      '*.rar' => 'RAR',
    ));
    if (!empty($data['ignoredExtensions'])) $f->attr('value', $data['ignoredExtensions']);
    $f->columnWidth = 50;
    $fs->append($f);

    $f = $modules->get('InputfieldTextarea');
    $f->attr('name', 'ignoredPath');
    $f->label = __('Excluded paths and patterns');
    $f->description = __('One per line: a folder starting and ending with `/` such as `/site/assets/files/1042/`, a file name, an extension such as `*.log`, or a regular expression between `%` signs.');
    $f->attr('value', (string) $data['ignoredPath']);
    $f->attr('rows', 5);
    $f->columnWidth = 50;
    $fs->append($f);

    $fields->append($fs);

    // ---- Storage
    $fs = $modules->get('InputfieldFieldset');
    $fs->label = __('Storage');
    $fs->icon = 'cloud';
    $fs->description = __('Where packages are kept. Each package is saved to every storage turned on here.');

    $field = $modules->get('InputfieldCheckbox');
    $field->attr('name', 'useLocalFolder');
    $field->label = __('This server');
    $field->description = __('A folder on the web server.');
    $field->attr('checked', !empty($data['useLocalFolder']) ? 'checked' : '');
    $fs->append($field);

    $sub = $modules->get('InputfieldFieldset');
    $sub->label = __('This server');
    $sub->showIf = 'useLocalFolder=1';
    $field = $modules->get('InputfieldText');
    $field->attr('name', 'path');
    $field->label = __('Folder');
    $field->description = __('An absolute path, or `~/` for a folder inside the site. Leave empty for the default.');
    $field->attr('placeholder', (string) self::$_data['defaultPath']);
    $field->attr('value', (string) $data['path']);
    $sub->append($field);
    $field = $modules->get('InputfieldCheckbox');
    $field->attr('name', 'orphanedLogs');
    $field->label = __('Clean up old logs');
    $field->description = __('Remove the log files of packages that were deleted.');
    $field->attr('checked', !empty($data['orphanedLogs']) ? 'checked' : '');
    $sub->append($field);
    $fs->append($sub);

    $field = $modules->get('InputfieldCheckbox');
    $field->attr('name', 'removeBackups');
    $field->label = __('Delete the package from this server after upload');
    $field->description = __('When this server is not a storage, the package built here can be deleted once it is uploaded.');
    $field->attr('checked', !empty($data['removeBackups']) ? 'checked' : '');
    $field->showIf = 'useLocalFolder=0';
    $fs->append($field);

    // FTP
    $field = $modules->get('InputfieldCheckbox');
    $field->attr('name', 'useFTP');
    $field->label = 'FTP';
    $field->description = __('Any FTP or FTPS server.');
    $field->attr('checked', !empty($data['useFTP']) ? 'checked' : '');
    $fs->append($field);

    $sub = $modules->get('InputfieldFieldset');
    $sub->label = 'FTP';
    $sub->showIf = 'useFTP=1';
    $texts = array(
      'ftpHostname' => array(__('Server'), 'ftp.example.com', 50),
      'ftpPort' => array(__('Port'), '21', 25),
      'ftpTimeout' => array(__('Timeout, in seconds'), '90', 25),
      'ftpUsername' => array(__('User'), '', 50),
      'ftpPassword' => array(__('Password'), '', 50),
      'ftpDirectory' => array(__('Folder'), 'backups/my-site', 100),
    );
    foreach ($texts as $name => $t) {
      $field = $modules->get('InputfieldText');
      $field->attr('name', $name);
      $field->label = $t[0];
      if ($t[1] !== '') $field->attr('placeholder', $t[1]);
      $field->attr('value', (string) $data[$name]);
      $field->columnWidth = $t[2];
      if ($name === 'ftpPassword') $field->attr('type', 'password');
      if ($name === 'ftpDirectory') $field->description = __('Created if it does not exist.');
      $sub->append($field);
    }
    $field = $modules->get('InputfieldCheckbox');
    $field->attr('name', 'ftpSSL');
    $field->label = __('Encrypted connection');
    $field->description = __('FTPS (FTP over TLS). Use it whenever the server supports it.');
    $field->attr('checked', !empty($data['ftpSSL']) ? 'checked' : '');
    $field->columnWidth = 50;
    $sub->append($field);
    $field = $modules->get('InputfieldCheckbox');
    $field->attr('name', 'ftpPassive');
    $field->label = __('Passive mode');
    $field->description = __('Needed by most servers behind a firewall.');
    $field->attr('checked', !empty($data['ftpPassive']) ? 'checked' : '');
    $field->columnWidth = 50;
    $sub->append($field);
    $fs->append($sub);

    // cloud storages need their PHP library
    $clouds = array(
      'useDropbox' => array('Dropbox', __('Packages go to the Apps/Duplicator folder.'), class_exists('DropboxClient'), 'composer require kunalvarma05/dropbox-php-sdk'),
      'useGoogleDrive' => array('Google Drive', __('Uploaded with a Google service account.'), class_exists('\Google_Client'), 'composer require google/apiclient'),
      'useAmazonS3' => array('Amazon S3', __('A bucket on Amazon S3. Packages stay private.'), class_exists('\Aws\S3\S3Client'), 'composer require aws/aws-sdk-php'),
    );
    foreach ($clouds as $name => $c) {
      $field = $modules->get('InputfieldCheckbox');
      $field->attr('name', $name);
      $field->label = $c[0];
      $field->description = $c[1];
      if (!$c[2]) {
        $field->notes = sprintf(__('Needs its PHP library. In the site root, run: `%s`'), $c[3]);
        $field->attr('disabled', 'disabled');
      }
      $field->attr('checked', !empty($data[$name]) && $c[2] ? 'checked' : '');
      $fs->append($field);

      $sub = $modules->get('InputfieldFieldset');
      $sub->label = $c[0];
      $sub->showIf = "$name=1";
      if ($name === 'useDropbox') {
        $field = $modules->get('InputfieldText');
        $field->attr('name', 'dropboxAccessToken');
        $field->attr('type', 'password');
        $field->label = __('Access token');
        $field->description = __('Create an app in the [Dropbox App Console](https://www.dropbox.com/developers/apps), then generate a token.');
        $field->attr('value', (string) $data['dropboxAccessToken']);
        $sub->append($field);
      } else if ($name === 'useGoogleDrive') {
        $field = $modules->get('InputfieldTextarea');
        $field->attr('name', 'googleKeyFile');
        $field->label = __('Service account key');
        $field->description = __('The JSON key of a service account, from the [Google Cloud console](https://console.cloud.google.com/apis/credentials).');
        $field->attr('value', (string) $data['googleKeyFile']);
        $sub->append($field);
        $field = $modules->get('InputfieldText');
        $field->attr('name', 'shareWithEmail');
        $field->label = __('Share with');
        $field->description = __('Your Google account, to see the packages in your own Drive.');
        $field->attr('value', (string) $data['shareWithEmail']);
        $sub->append($field);
      } else {
        $texts = array(
          'awsAccessKey' => array(__('Access key ID'), '', 50),
          'awsSecretKey' => array(__('Secret access key'), '', 50),
          'awsBucketName' => array(__('Bucket'), __('Created if it does not exist.'), 50),
          'awsSubDir' => array(__('Folder in the bucket'), '', 50),
        );
        foreach ($texts as $key => $t) {
          $field = $modules->get('InputfieldText');
          $field->attr('name', $key);
          $field->label = $t[0];
          if ($t[1] !== '') $field->description = $t[1];
          $field->attr('value', (string) $data[$key]);
          $field->columnWidth = $t[2];
          if ($key === 'awsSecretKey') $field->attr('type', 'password');
          $sub->append($field);
        }
        // https://docs.aws.amazon.com/general/latest/gr/s3.html
        $field = $modules->get('InputfieldSelect');
        $field->attr('name', 'awsRegion');
        $field->label = __('Region');
        $field->addOptions(array(
          'us-east-1' => 'US East (N. Virginia)',
          'us-east-2' => 'US East (Ohio)',
          'us-west-1' => 'US West (N. California)',
          'us-west-2' => 'US West (Oregon)',
          'ca-central-1' => 'Canada (Central)',
          'ap-south-1' => 'Asia Pacific (Mumbai)',
          'ap-northeast-2' => 'Asia Pacific (Seoul)',
          'ap-southeast-1' => 'Asia Pacific (Singapore)',
          'ap-southeast-2' => 'Asia Pacific (Sydney)',
          'ap-northeast-1' => 'Asia Pacific (Tokyo)',
          'eu-central-1' => 'Europe (Frankfurt)',
          'eu-west-1' => 'Europe (Ireland)',
          'eu-west-2' => 'Europe (London)',
          'eu-west-3' => 'Europe (Paris)',
          'eu-north-1' => 'Europe (Stockholm)',
          'sa-east-1' => 'South America (São Paulo)',
        ));
        $field->attr('value', (string) $data['awsRegion']);
        $sub->append($field);
      }
      $fs->append($sub);
    }
    $fields->append($fs);

    // ---- Schedule and retention
    $fs = $modules->get('InputfieldFieldset');
    $fs->label = __('Schedule and retention');
    $fs->icon = 'clock-o';

    $field = $modules->get('InputfieldRadios');
    $field->attr('name', 'cronMode');
    $field->label = __('Automatic backups');
    $field->description = __('Packages can always be built from Setup > Duplicator.');
    $field->addOption('none', __("Off, or with your server's scheduler"));
    $field->addOption('LazyCron', __('On site visits (LazyCron)') . ($modules->isInstalled('LazyCron') ? '' : ' - ' . __('not installed')));
    $field->addOption('PWCron', __('With the PwCron module') . ($modules->isInstalled('PwCron') ? '' : ' - ' . __('not installed')));
    $field->attr('value', $data['cronMode'] ? $data['cronMode'] : 'none');
    $field->notes = sprintf(__('Cron command, to run for example every night: `php %s`'), rtrim($config->paths->{self::DUP_APPLICATION_NAME}, '/\\') . '/cron.php');
    $fs->append($field);

    $field = $modules->get('InputfieldSelect');
    $field->attr('name', 'cycle');
    $field->label = __('Interval');
    $field->description = __('How often a visit may start a backup.');
    $field->addOptions(array(
      0 => __('Off'),
      'everyHour' => __('Every hour'),
      'every6Hours' => __('Every 6 hours'),
      'everyDay' => __('Every day'),
      'every2Days' => __('Every 2 days'),
      'everyWeek' => __('Every week'),
      'every2Weeks' => __('Every 2 weeks'),
      'every4Weeks' => __('Every 4 weeks'),
      'logoutTrigger' => __('When a user with the duplicator permission logs out'),
    ));
    $field->attr('value', $data['cycle']);
    $field->showIf = "cronMode='LazyCron'";
    $fs->append($field);

    $field = $modules->get('InputfieldInteger');
    $field->attr('name', 'maxPackages');
    $field->label = __('Keep at most');
    $field->description = sprintf(__('Number of packages, from 1 to %d. Older packages are deleted after each new one, in every storage.'), self::DUP_MAX_PACKAGES);
    $field->attr('min', 1);
    $field->attr('max', self::DUP_MAX_PACKAGES);
    $field->attr('value', $data['maxPackages']);
    $field->columnWidth = 50;
    $fs->append($field);

    $field = $modules->get('InputfieldSelect');
    $field->attr('name', 'deadline');
    $field->label = __('Delete packages older than');
    $field->addOptions(array(
      '' => __('Never'),
      '1 minute' => __('1 minute (testing only)'),
      '1 day' => __('1 day'),
      '1 week' => __('1 week'),
      '1 month' => __('1 month'),
      '1 year' => __('1 year'),
    ));
    $field->attr('value', $data['deadline'] === 'never' ? '' : $data['deadline']);
    $field->columnWidth = 50;
    $fs->append($field);

    $fields->append($fs);

    // ---- Encryption
    $fs = $modules->get('InputfieldFieldset');
    $fs->label = __('Encryption');
    $fs->icon = 'lock';
    $fs->description = __('Packages are encrypted before they are stored anywhere. The server only knows the public key: it can encrypt, never decrypt.');
    if (!DupCrypto::isAvailable()) {
      $fs->notes = __('The PHP sodium extension is not enabled on this server. Enable `extension=sodium` in php.ini, or no package can be built while encryption is on.');
    }

    $field = $modules->get('InputfieldCheckbox');
    $field->attr('name', 'encryptionEnabled');
    $field->label = __('Encrypt packages');
    $field->description = __('If a package cannot be encrypted, it is deleted. An unencrypted copy never leaves the server.');
    $field->attr('checked', !empty($data['encryptionEnabled']) ? 'checked' : '');
    $fs->append($field);

    $field = $modules->get('InputfieldText');
    $field->attr('name', 'encryptionPublicKey');
    $field->label = __('Public key');
    $field->description = __('Starts with `dup-pk1:`. Never paste the secret key (`dup-sk1:`) here.');
    $field->attr('value', (string) $data['encryptionPublicKey']);
    $field->showIf = 'encryptionEnabled=1';
    $field->requiredIf = 'encryptionEnabled=1';
    if (strlen($data['encryptionPublicKey']) && DupCrypto::isAvailable()) {
      try {
        DupCrypto::parsePublicKey($data['encryptionPublicKey']);
        $field->notes = __('Valid public key.');
      } catch (\Exception $e) {
        $field->error($e->getMessage());
      }
    }
    $fs->append($field);

    // the secret key is never generated nor shown here: it must not exist on this server
    $dupcryptUrl = $config->urls->admin . 'setup/' . strtolower(self::DUP_APPLICATION_NAME) . '/?action=dupcrypt';
    $field = $modules->get('InputfieldMarkup');
    $field->label = __('Create your keys');
    $field->description = __('Do it once, on your own computer. It needs PHP 7.2 or newer installed on that computer.');
    $field->showIf = 'encryptionEnabled=1';
    $field->markupText = '<ol>'
      . '<li><strong>' . __('Download the encryption tool:') . "</strong> <a href='" . htmlspecialchars($dupcryptUrl, ENT_QUOTES, 'UTF-8') . "'>dupcrypt.php</a></li>"
      . '<li><strong>' . __('Run it in a terminal.') . '</strong> ' . __('Open a terminal in the folder where you saved the file and run') . ' <code>php dupcrypt.php keygen</code>. ' . __('It prints a public key (dup-pk1:...) and a secret key (dup-sk1:...).') . '</li>'
      . '<li><strong>' . __('Paste the public key above') . '</strong> ' . __('and save.') . '</li>'
      . '<li><strong>' . __('Store the secret key in your password manager.') . '</strong> ' . __('It is the only way to restore an encrypted package. Never put it on this server.') . '</li>'
      . '</ol>';
    $fs->append($field);

    $fields->append($fs);

    // ---- Advanced
    $fs = $modules->get('InputfieldFieldset');
    $fs->label = __('Advanced');
    $fs->icon = 'sliders';

    $mysqldump = false;
    $zipBinary = false;
    if (DUP_Util::isEnabled('shell_exec')) {
      $found = DUP_Util::isWinOS() ? shell_exec('where mysqldump 2>NUL') : shell_exec('command -v mysqldump 2>/dev/null');
      $mysqldump = is_string($found) && trim($found) !== '';
      if (!DUP_Util::isWinOS()) {
        $found = shell_exec('command -v zip 2>/dev/null');
        $zipBinary = is_string($found) && trim($found) !== '';
      }
    }

    $f = $modules->get('InputfieldRadios');
    $f->attr('name', 'backup_mode');
    $f->label = __('Database dump');
    $f->addOption(self::DUP_MODE_PWAPI, __('PHP - works on every server'));
    if ($mysqldump) $f->addOption(self::DUP_MODE_NATIVE, __('mysqldump - faster for large databases, runs a shell script'));
    $f->attr('value', (int) $data['backup_mode']);
    $f->notes = implode("\n", array(
      (extension_loaded('zip') ? __('PHP zip extension: available.') : __('PHP zip extension: missing, it is required to build packages.')),
      ($mysqldump ? __('mysqldump: available.') : __('mysqldump: not found, the mysqldump method is not available.')),
      ($zipBinary ? __('zip command: available.') : __('zip command: not found, PHP builds the archives.')),
    ));
    $fs->append($f);

    $f = $modules->get('InputfieldText');
    $f->attr('name', 'chmodPermission');
    $f->label = __('Script permissions');
    $f->description = __('Applied to the generated script. 0700 lets only the web server user read and run it.');
    $f->attr('value', $data['chmodPermission'] ? $data['chmodPermission'] : '0700');
    $f->showIf = 'backup_mode=' . self::DUP_MODE_NATIVE;
    $fs->append($f);

    $f = $modules->get('InputfieldTextarea');
    $f->attr('name', 'shellScript');
    $f->label = __('Dump script');
    $f->description = __('Placeholders such as `%%DATABASE%%` are replaced when the script runs.');
    $f->attr('rows', 14);
    $stub = DUP_Util::getStub();
    $f->attr('value', $data['shellScript'] ? $data['shellScript'] : ($stub ? file_get_contents($stub) : ''));
    $f->showIf = 'backup_mode=' . self::DUP_MODE_NATIVE;
    $fs->append($f);

    $field = $modules->get('InputfieldInteger');
    $field->attr('name', 'zip_flush_mbytes');
    $field->label = __('Write the archive every (MB)');
    $field->description = __('Saves memory on very large sites. 0 writes it once at the end.');
    $field->attr('value', (int) $data['zip_flush_mbytes']);
    $fs->append($field);

    $fields->append($fs);

    // a checkbox shows its label next to the box: no header repeating it
    foreach ($fields->getAll() as $f) {
      if ($f instanceof InputfieldCheckbox) $f->skipLabel = Inputfield::skipLabelHeader;
    }

    return $fields;
  }

}